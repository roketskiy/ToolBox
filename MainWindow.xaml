<Window x:Class="ToolBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolBox"
        Width="920" Height="640" MinWidth="680" MinHeight="480"
        WindowStyle="None" Background="{StaticResource PageBg}"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextElement.Foreground="{StaticResource TextPrimary}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource PageBg}" CornerRadius="10"
        BorderBrush="#1D1D1F" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏（Windows 风格） -->
        <Border Grid.Row="0" Background="{StaticResource PageBg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="ToolBox" Margin="16,0,0,0" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="最小化" Click="Minimize_Click"
                            AutomationProperties.Name="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButtonStyle}" ToolTip="最大化" Click="Maximize_Click"
                            AutomationProperties.Name="最大化">
                        <TextBlock x:Name="MaxIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" ToolTip="关闭 (Alt+F4)" Click="Close_Click"
                            AutomationProperties.Name="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 搜索区 -->
        <Border Grid.Row="1" Margin="16,0,16,14" Height="34" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center" FontSize="14" Padding="8,0,0,0"
                         TextChanged="Search_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="搜索工具" FontSize="14"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                           Margin="8,0,0,0" IsHitTestVisible="False"/>
                <Button x:Name="ClearButton" Grid.Column="2" Content="&#x2715;" Width="28" Height="28" Margin="0,0,6,0"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                        ToolTip="清除搜索" Visibility="Collapsed" Click="Clear_Click" Focusable="False"/>
            </Grid>
        </Border>

        <!-- 工具卡片 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16,0,16,84">
            <ItemsControl x:Name="CardList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="CardButton" Width="240" Height="104" Margin="0,0,12,12"
                                Tag="{Binding}" ToolTip="单击启动" Click="Card_Click"
                                Style="{StaticResource CardButtonStyle}">
                            <Grid Margin="12,0,12,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="48" Height="48" Source="{Binding Icon}" SnapsToDevicePixels="True"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxHeight="18" Margin="0,0,22,0"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="17" MaxHeight="34" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="MoreButton" Grid.Column="1" Width="22" Height="22"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"
                                        Content="&#x22EF;" FontSize="16" Foreground="{StaticResource TextSecondary}"
                                        Background="Transparent" BorderThickness="0" ToolTip="更多操作"
                                        Tag="{Binding}" Click="More_Click" Visibility="Collapsed">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="MoreBg" Background="Transparent" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MoreBg" Property="Background" Value="#E8E8ED"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardButton}" Value="True">
                                <Setter TargetName="MoreButton" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=CardButton}" Value="True">
                                <Setter TargetName="MoreButton" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="还没有工具，点击右下角的 + 添加第一个程序"
                   Foreground="{StaticResource TextSecondary}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <!-- 添加按钮 -->
        <Button x:Name="AddButton" Grid.Row="2" Width="48" Height="48" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,20,20" ToolTip="添加工具 (Ctrl+N)" Click="Add_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Fab" Fill="{StaticResource Accent}"/>
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="White" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 0,-6 L 0,6 M -6,0 L 6,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fab" Property="Fill" Value="#3395FF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fab" Property="Fill" Value="#0066CC"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fab" Property="Stroke" Value="#1D1D1F"/>
                            <Setter TargetName="Fab" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Border>
</Window>




