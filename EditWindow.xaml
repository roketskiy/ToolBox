<Window x:Class="ToolBox.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加工具" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource PageBg}" FontFamily="Segoe UI Variable, Segoe UI"
        TextElement.Foreground="{StaticResource TextPrimary}">
    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="IconPreview" Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0" SnapsToDevicePixels="True"/>
            <TextBlock Grid.Column="1" x:Name="Heading" Text="添加工具" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="名称 *" Margin="0,16,0,4" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
        <TextBox x:Name="NameBox" FontSize="14" Padding="6,4"/>
        <TextBlock Text="简介 *" Margin="0,10,0,4" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
        <TextBox x:Name="DescBox" FontSize="14" Padding="6,4" AcceptsReturn="True" TextWrapping="Wrap" Height="64"/>
        <TextBlock Text="可执行文件 *" Margin="0,10,0,4" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ExeBox" FontSize="13" Padding="6,4" TextChanged="Exe_TextChanged"/>
            <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="12,4" Click="BrowseExe_Click"/>
        </Grid>
        <TextBlock Text="工作目录" Margin="0,10,0,4" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WorkDirBox" FontSize="13" Padding="6,4"/>
            <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="12,4" Click="BrowseDir_Click"/>
        </Grid>
        <TextBlock Text="启动参数" Margin="0,10,0,4" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
        <TextBox x:Name="ArgsBox" FontSize="13" Padding="6,4" FontFamily="Consolas"/>
        <TextBlock Text="自定义图标（可选，留空则使用程序图标）" Margin="0,10,0,4" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="IconBox" FontSize="13" Padding="6,4" TextChanged="Icon_TextChanged"/>
            <Button Grid.Column="1" Content="选择…" Margin="8,0,0,0" Padding="12,4" Click="BrowseIcon_Click"/>
            <Button Grid.Column="2" Content="清除" Margin="8,0,0,0" Padding="12,4" Click="ClearIcon_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" MinWidth="88" Padding="12,4" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="保存" MinWidth="88" Padding="12,4" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
